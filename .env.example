# Use forward slashes "/" in paths for compatibility across platforms

# Storage
# JSON file for app metadata (product name), keyed by app id.
STEAM_TRACKER_APP_INFO_PATH="data/apps.json"

# JSON file recording the last date each app was emailed (email dedup).
STEAM_TRACKER_ALERT_STATE_PATH="data/alert_state.json"

# JSON file of tracked apps and their optional USD alert thresholds, keyed by
# app id. Edited by the registry CLI.
# Example: data/tracked_apps.json
STEAM_TRACKER_APPS_PATH="data/tracked_apps.json"


# Email alerts
# Recipient address for price-alert digest emails. Treated as a secret (a
# personal address): supply it via the environment / the gitignored smtp.env
# alongside the SMTP credentials, never a committed file. Required for email —
# without it (or the SMTP credentials) email stays off and only console alerts
# are used.
STEAM_TRACKER_EMAIL_TO=""

# SMTP server host used to send alert emails.
STEAM_TRACKER_SMTP_HOST="smtp.gmail.com"

# SMTP server port (587 = STARTTLS).
STEAM_TRACKER_SMTP_PORT="587"

# SMTP account to authenticate as, also the From address. Email is enabled only
# when SMTP_USER, SMTP_PASSWORD, and EMAIL_TO are all set.
STEAM_TRACKER_SMTP_USER=""

# SMTP password (a Gmail App Password). Keep this out of the repo; supply it via
# the environment or an untracked .env file.
STEAM_TRACKER_SMTP_PASSWORD=""
